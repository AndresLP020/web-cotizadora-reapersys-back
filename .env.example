# =============================================================================
# ReaperSys — Backend
# Copie este archivo como `.env` (o `.env.local`) y ajuste los valores.
# NUNCA versione archivos .env con secretos reales.
# =============================================================================

NODE_ENV=development
PORT=4000
# true solo si la API corre detrás de un proxy inverso de confianza.
TRUST_PROXY=false

# URL pública del frontend (enlaces en correos y PDFs).
PUBLIC_APP_URL=http://localhost:3000
# Orígenes permitidos para CORS, separados por coma. No se aceptan comodines.
CORS_ORIGINS=http://localhost:3000

# --- MongoDB -----------------------------------------------------------------
# Local (docker compose, replica set de un nodo => transacciones habilitadas):
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
# Atlas (ejemplo, sin credenciales reales):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=reapersys
# Por defecto: true en desarrollo, false en producción.
# MONGODB_AUTO_INDEX=true

# --- Sesiones ----------------------------------------------------------------
# Obligatorio en producción (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
COOKIE_DOMAIN=

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Documentación OpenAPI en /api/docs. Por defecto: activa salvo en producción.
# SWAGGER_ENABLED=true

# --- Correo transaccional ----------------------------------------------------
# simulated = no envía nada y registra la operación como SIMULADA (nunca como entregada).
EMAIL_PROVIDER=simulated
EMAIL_FROM=ReaperSys <cotizaciones@example.com>
EMAIL_ADMIN_NOTIFY=
RESEND_API_KEY=

# --- WhatsApp Business Platform (Cloud API) ----------------------------------
# simulated | meta_cloud. meta_cloud exige todas las variables siguientes.
WHATSAPP_PROVIDER=simulated
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Nombre de la plantilla aprobada por Meta para enviar cotizaciones.
WHATSAPP_QUOTE_TEMPLATE=

# --- Documentos PDF ----------------------------------------------------------
# gridfs = almacenamiento privado dentro de MongoDB.
DOCUMENT_STORAGE=gridfs

# --- Cola de notificaciones -----------------------------------------------------
# El worker procesa la cola dentro del proceso de la API (desactivado en pruebas).
NOTIFICATIONS_WORKER_ENABLED=true
NOTIFICATIONS_POLL_SECONDS=5
NOTIFICATIONS_MAX_ATTEMPTS=5

# --- Recordatorios de cobranza -----------------------------------------------
# Revisa cada hora rentas y compras con cobro pendiente (desactivado en pruebas).
BILLING_REMINDERS_ENABLED=true
# Días antes (0 = el mismo día) y después del vencimiento en que se avisa al cliente.
BILLING_REMINDER_DAYS_BEFORE=5,1,0
BILLING_REMINDER_DAYS_AFTER=1,7,15
# Hora local (America/Mexico_City) a partir de la cual se envían.
BILLING_REMINDER_HOUR=9
# Idioma de la plantilla de WhatsApp aprobada en Meta.
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
