{
  "name": "@reapersys/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de ReaperSys (NestJS + MongoDB).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node scripts/jest.cjs",
    "test:watch": "node scripts/jest.cjs --watch",
    "test:cov": "node scripts/jest.cjs --coverage",
    "test:e2e": "node scripts/jest.cjs --config ./test/jest-e2e.json --runInBand",
    "seed": "nest build && node dist/database/seeds/run-seed.js",
    "preuser:create": "nest build",
    "user:create": "node dist/security/create-user.cli.js",
    "predb:indexes": "nest build",
    "db:indexes": "node dist/database/create-indexes.cli.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.2",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
